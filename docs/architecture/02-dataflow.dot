// 星塔机器人 —— 运行期数据流（四条链）
// 依据：cmd/xingtabot/main.go 的装配 + 各包实现。箭头方向 = 数据流动方向，不是 import 方向。
digraph dataflow {
	graph [fontname="Microsoft YaHei", rankdir=TB, ranksep=0.55, nodesep=0.22,
	       labelloc=t, fontsize=20, label="运行期数据流：同步链 / 提醒链 / 命令链 / 人工覆盖回写", splines=true];
	node [fontname="Microsoft YaHei", shape=box, style="rounded,filled", fontsize=11,
	      fillcolor="#f5f6f8", color="#3c3f44", margin="0.14,0.08"];
	edge [fontsize=9.5, color="#6b7076", arrowsize=0.55];

	// ===== 外部 =====
	qqplat [label="QQ 开放平台", shape=ellipse, fillcolor="#cfe2ff", peripheries=2, fontsize=13];
	gsite  [label="星塔官网 CDN", shape=ellipse, fillcolor="#cfe2ff", peripheries=2, fontsize=13];

	// ===== 链 1：同步（公告 → 存储 → 日历）=====
	subgraph cluster_sync {
		label="① 同步链  annsync（每 -refresh，默认 30 分钟一轮；冷启动立即跑一轮）";
		fontsize=13; style="rounded"; color="#7b3fa0"; fillcolor="#faf5ff";

		list   [label="src.List()\n拉公告目录 → []Ref\n（分页，1 基页码）", fillcolor="#f1e6fa"];
		pick   [label="pick(refs, state, full)\n指纹变了的才抓\nfull = 距 LastFull 超 FullEvery", fillcolor="#f1e6fa"];
		fetch  [label="src.Fetch(ref) 串行 + MinGap 限速\n解析规则 v2：只认标题「」里的名字\n+ 恰好一个主时间窗口", fillcolor="#f1e6fa"];
		branch [label="出错分支", shape=diamond, fillcolor="#fff3cd"];
		item   [label="Item（条目快照）\nEvents[] + Suspect + Note", fillcolor="#f1e6fa"];
		reproj [label="reproject() 全量投影\nloadItems → (Merger?) → buildRecs\n→ Rec → project(recs, overrides)", fillcolor="#f1e6fa"];
		dupwarn[label="多篇公告声明同一时间窗口\n→ 日历只留一行 + 打警告日志", fillcolor="#fff3cd"];
	}

	// ===== 存储 =====
	subgraph cluster_store {
		label="bbolt（store.Doc，按 ns 隔离；值是 JSON 字节，无编译期 schema）";
		fontsize=13; style="rounded"; color="#2f6f4f"; fillcolor="#f2faf5";
		nsSync  [label="ns \"sync\"\n同步状态：Known/Pending\nLastFull/LastSuccess/Fails", fillcolor="#dff0e6"];
		nsNews  [label="ns \"news\"\n公告条目快照\nkey = 源:refID", fillcolor="#dff0e6"];
		nsAct   [label="ns \"activity\"\n投影后的 Rec\n（含 pending 状态）", fillcolor="#dff0e6"];
		nsOv    [label="ns \"override\"\n人工覆盖 annsync.OverrideStore", fillcolor="#dff0e6"];
		nsExp   [label="ns \"calexpiry\"\n已提醒记录 key=活动ID", fillcolor="#dff0e6"];
		calds   [label="kernel/calendar Store（内存）\nbyID + byStart 有序切片\n查询毫秒级，进程重启由投影重建", fillcolor="#dff0e6", shape=box3d];
	}

	// ===== 链 2：到期提醒（日历 → 主动消息）=====
	subgraph cluster_remind {
		label="② 提醒链  calexpiry + kernel（唯一用主动消息的功能，吃日额度）";
		fontsize=13; style="rounded"; color="#b25a00"; fillcolor="#fffaf2";

		ticker [label="自己的 goroutine\ntime.Ticker(-scan，默认 10 分钟)\n启动先扫一遍补发", fillcolor="#ffe8cc"];
		scan   [label="scan: Calendar().EndingWithin(now, Lead 48h)\n→ Schedule(id, End-Lead) 幂等排期\n→ 离开窗口的 Cancel 撤排期", fillcolor="#ffe8cc"];
		heap   [label="kernel/schedule 最小堆\n1 个 goroutine + 1 把 timer\n同 ID 再 Schedule = 原地改期", fillcolor="#ffe8cc"];
		remind [label="到点 runDue → calexpiry.remind\n拼文案 message(act, now)\n全部目标投递成功才 markSent", fillcolor="#ffe8cc"];
		submit [label="api.Submit(queue.Item)\nTopic=\"expiry\" Mergeable=true\nID=\"expiry:活动@目标\"", fillcolor="#ffe8cc"];
		q      [label="kernel/queue Dispatcher", fillcolor="#ffd699"];
		gate   [label="准入闸门（锁内决策，锁外交付）\n单群桶 20qpm burst4 ｜全局桶 60qpm burst8\n每群 1000/天（固定 +08:00）｜单群积压上限 200\n队列满 → ErrQueueFull 交调用方重排", fillcolor="#ffd699"];
		merge  [label="MergeWindow 1.5s 内同 Topic 合并成 1 个 Batch\n跨群公平轮转（served 时间）避免队头吃光额度", fillcolor="#ffd699"];
		worker [label="2 个 worker → Sink.Send(*Batch)\n失败退避：1s ×3，最多 4 次\n超期(Deadline 10m)/永久失败/溢出分别计数", fillcolor="#ffd699"];
		sink   [label="main.activeSink\nsplitTarget(\"g:\"/\"u:\")\n→ SendGroupMessage / SendC2CMessage", fillcolor="#ffe8cc"];
		silent [label="注意：schedule.OnError 全项目零赋值\n→ 回调返回的错误被静默丢弃\n只剩下一轮 scan 重排兜底", fillcolor="#f8d7da"];
	}

	// ===== 链 3：命令（@机器人 → 被动回复）=====
	subgraph cluster_cmd {
		label="③ 命令链  qq + command（被动回复，不吃主动消息配额）";
		fontsize=13; style="rounded"; color="#1f5c8b"; fillcolor="#f3f8fd";

		gw     [label="qq.Gateway（WS）\nidentify → 心跳带 ACK\n断线：可 resume 则 resume，否则重新 identify\n退避分级，连续失败不清零", fillcolor="#d6e9f8"];
		hook   [label="qq webhook 前端（已实现，线上未接）\ned25519 验签 + validation 握手\n与 Gateway 共用同一个 Hub", fillcolor="#eef1f4", style="rounded,filled,dashed"];
		hub    [label="qq.Hub.Handle → dispatch\nDeduper.See(kind,id) 5 分钟窗口去重\n（resume 回放靠它压掉）\n处理器错误不外抛给传输层", fillcolor="#d6e9f8"];
		disp   [label="command.dispatch\n取 m.Text() 首字段查表\n查不到 → 静默不回「没听懂」", fillcolor="#d6e9f8"];
		admin  [label="权限\n群：member_role = owner/admin\n单聊：-admin 白名单 openid", fillcolor="#d6e9f8"];
		runs   [label="Cmd.Run(ctx, *qq.Message, args) → (string, error)\ncalquery：活动 / 快结束 / 即将 / 帮助（分页）\ncalops ：待确认 / 覆盖 / 确认 / 隐藏 / 显示", fillcolor="#d6e9f8"];
		replyf [label="reply()\nrune 安全截断到 MaxRunes 1500\nMsgType=文本 + msg_id + msg_seq", fillcolor="#d6e9f8"];
		limit  [label="replier 次数闸门（客户端侧）\n同一条来消息：群最多 5 次 / 单聊 4 次\n触闸只记日志，绝不降级成主动消息", fillcolor="#d6e9f8"];
	}

	// ===== 链 4：人工覆盖回写 =====
	subgraph cluster_ops {
		label="④ 人工修正回写：错的公告不必等官方改口";
		fontsize=13; style="rounded"; color="#8a6d1f"; fillcolor="#fffdf2";
		ov [label="写 ns \"override\"（改期/固化/隐藏）\n→ 立刻调 annsync.Refresh()\n→ 重跑投影，不用等下一轮", fillcolor="#fdf1c7"];
	}

	// ---------- 边 ----------
	gsite -> list -> pick -> fetch -> item;
	item -> nsNews;
	fetch -> branch;
	branch -> nsSync [label="限流/未知错：中断抓取\n但先投影已抓到的"];
	branch -> fetch   [label="Permanent：跳过这条继续"];
	fetch -> nsSync [label="Known[ref]=指纹\nPending / RetryAge 30 天"];

	list -> nsSync [dir=back, label="读进度"];
	nsSync  -> reproj [dir=back];
	nsNews  -> reproj;
	nsAct   -> reproj [dir=back, label="saveRecs 差集清理"];
	nsOv    -> reproj [label="All() 逐条应用\n刷新永不删覆盖"];
	reproj -> dupwarn;
	reproj -> nsAct;
	reproj -> calds [label="BulkUpsert(acts)\nRemoveSet(消失的 id)", weight=4, color="#7b3fa0", penwidth=1.6];

	calds -> scan [label="只读 View.EndingWithin"];
	ticker -> scan -> heap -> remind -> submit -> q -> gate -> merge -> worker -> sink -> qqplat;
	heap -> silent [style=dotted, color="#c0392b"];
	remind -> nsExp [label="markSent / 启动时 loadSent"];
	scan -> calds [dir=back, style=invis];

	qqplat -> gw -> hub -> disp -> admin -> runs -> replyf -> limit -> qqplat;
	hook -> hub [style=dashed, color="#9aa0a6"];
	runs -> calds [label="查询只读 Active/Upcoming/EndingWithin", color="#1f5c8b"];
	runs -> nsAct [label="待确认桶读 Rec（经 annsync 只读面）", color="#1f5c8b"];

	runs -> ov -> reproj [color="#8a6d1f", penwidth=1.4, label="重投影", fontcolor="#8a6d1f"];

	// 观测出口
	calds -> nsExp [style=invis];
}
